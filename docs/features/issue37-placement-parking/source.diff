+    private int PlacementCategoryFor(WorkBay point)
+    {
+        if (point == null) return -1;
+        foreach (PlacementVisual visual in PlacementVisuals()) if (Object.ReferenceEquals(visual.Point, point)) return visual.Category;
+        return -1;
+    }
