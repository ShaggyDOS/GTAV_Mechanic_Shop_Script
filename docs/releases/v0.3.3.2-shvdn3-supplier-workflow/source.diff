+                else high = mid - 1;
+            }
+            fitted = caption.Substring(0, low) + "...";
+        }
+        if (_menuFitCache.Count >= 128) _menuFitCache.Clear();
+        _menuFitCache[key] = fitted;
+        return fitted;
+    }
