+    // PR19: invoked only by the existing once-per-second visual refresh after
+    // the gameplay gate. Never edits ETA, stock, invoices, saves or waypoints.
+    private void UpdateWholesalePackageBlip(DateTime now)
+    {
+        if (now < _nextWholesaleBlipRetry) return;
+        try
+        {
+            if (_deliverySupplier != 0 || _deliveryKind < -1 || _deliveryKind > 2 ||
+                _deliveryQuantity <= 0 || !_wholesaleWarehousePickup.IsSet)
+            { DeleteWholesalePackageBlip(); return; }
+            if (!_wholesalePackageHasPosition || _wholesalePackageOrderIdentity != _deliveryDueUtcTicks)
+            {
+                _wholesalePackageOrderIdentity = _deliveryDueUtcTicks;
+                _wholesalePackageLastPosition = _wholesaleWarehousePickup.Position;
+                _wholesalePackageHasPosition = true;
+                _wholesaleBlipVehicle = null;
+                _nextWholesaleBlipVehicleCheck = DateTime.MinValue;
+            }
+            Vector3 position = WholesalePackageBlipPosition(now);
+            _wholesalePackageLastPosition = position;
+            if (_wholesalePackageBlip == null || !_wholesalePackageBlip.Exists())
+            {
+                _wholesalePackageBlipConfigured = false;
+                _wholesalePackageBlip = World.CreateBlip(position);
+                if (_wholesalePackageBlip == null || !_wholesalePackageBlip.Exists())
+                    throw new InvalidOperationException("Wholesale package blip unavailable");
+            }
+            // Retain the handle if a setter fails: retry configuring that same
+            // owned blip after backoff instead of leaking duplicate handles.
+            if (!_wholesalePackageBlipConfigured)
+            {
+                _wholesalePackageBlip.Sprite = BlipSprite.Package;
+                _wholesalePackageBlip.Color = BlipColor.Orange;
+                _wholesalePackageBlip.Scale = 0.85f;
+                _wholesalePackageBlip.IsShortRange = false;
+                _wholesalePackageBlip.Name = "WHOLESALE package";
+                _wholesalePackageBlipConfigured = true;
+            }
+            _wholesalePackageBlip.Position = position;
+        }
+        catch (Exception ex)
+        {
+            _nextWholesaleBlipRetry = now.AddSeconds(10);
+            Log("Wholesale package blip (order preserved)", ex);
+        }
+    }
+
+    private Vector3 WholesalePackageBlipPosition(DateTime now)
+    {
+        // Both ETA and ready pickup remain actionable at the fixed warehouse,
+        // including missing models or a recovery that resets cargo flags.
+        if (_deliveryRemainingGameSeconds > 0 ||
+            (!_supplierPlayerCarrying && !_wholesaleCargoLoaded && !_wholesaleCargoUnloaded))
+        {
+            _wholesaleBlipVehicle = null;
+            _nextWholesaleBlipVehicleCheck = DateTime.MinValue;
+            return _wholesaleWarehousePickup.Position;
+        }
+        Ped player = Game.Player.Character;
+        if (_supplierPlayerCarrying || _wholesaleCargoUnloaded)
+        {
+            if (player != null && player.Exists()) return player.Position;
+        }
+        else if (_wholesaleCargoLoaded)
+        {
+            // Keep an independent last validated reference when the existing
+            // nearby-cargo visual cache streams out. No new vehicle scans.
+            if (now >= _nextWholesaleBlipVehicleCheck)
+            {
+                _nextWholesaleBlipVehicleCheck = now.AddSeconds(3);
+                if (!MatchesWholesaleVehicle(_wholesaleBlipVehicle))
+                {
+                    _wholesaleBlipVehicle = MatchesWholesaleVehicle(_cachedWholesaleVehicle)
+                        ? _cachedWholesaleVehicle : null;
+                    if (_wholesaleBlipVehicle == null && player != null && player.Exists() &&
+                        player.IsInVehicle() && MatchesWholesaleVehicle(player.CurrentVehicle))
+                        _wholesaleBlipVehicle = player.CurrentVehicle;
+                }
+            }
+            if (_wholesaleBlipVehicle != null && _wholesaleBlipVehicle.Exists() &&
+                _wholesaleBlipVehicle.Model.Hash == _wholesaleVehicleModel)
+                return _wholesaleBlipVehicle.Position;
+            if (_supplierCrate != null && _supplierCrate.Exists()) return _supplierCrate.Position;
+        }
+        // Missing entity: leave the owned icon at the last observed actionable
+        // location. Fresh reloads start with warehouse until cargo is resolved.
+        return _wholesalePackageLastPosition;
+    }
+
+    private void DeleteWholesalePackageBlip()
+    {
+        try
+        {
+            if (_wholesalePackageBlip != null && _wholesalePackageBlip.Exists())
+                _wholesalePackageBlip.Remove();
+            _wholesalePackageBlip = null;
+            _wholesalePackageBlipConfigured = false;
+            _wholesalePackageHasPosition = false;
+            _wholesaleBlipVehicle = null;
+        }
+        catch (Exception ex)
+        {
+            // Preserve ownership for the next cleanup attempt; never remove an
+            // arbitrary marker, customer icon or user-created waypoint.
+            _nextWholesaleBlipRetry = DateTime.UtcNow.AddSeconds(10);
+            Log("Wholesale package blip cleanup", ex);
+        }
+    }
