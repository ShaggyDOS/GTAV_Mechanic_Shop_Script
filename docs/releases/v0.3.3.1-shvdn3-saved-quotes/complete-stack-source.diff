+    private bool TryConsumeQuotedSupplies(RepairQuote quote)
+    {
+        if (quote == null || quote.ServiceKind < -1 || quote.ServiceKind > 2 ||
+            quote.DedicatedUnits < 0 || quote.UniversalUnits < 0 ||
+            (quote.ServiceKind == -1 && quote.DedicatedUnits != 0) ||
